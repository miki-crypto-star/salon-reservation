{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "shops": {
      "$shopCode": {
        "settings": {
          ".read": true,
          ".write": "auth != null && root.child('users').child(auth.uid).child('shopCode').val() === $shopCode"
        },
        "menus": {
          ".read": true,
          ".write": "auth != null && root.child('users').child(auth.uid).child('shopCode').val() === $shopCode"
        },
        "stylists": {
          ".read": true,
          ".write": "auth != null && root.child('users').child(auth.uid).child('shopCode').val() === $shopCode"
        },
        "dateOverrides": {
          ".read": true,
          ".write": "auth != null && root.child('users').child(auth.uid).child('shopCode').val() === $shopCode"
        },
        "staffBlocks": {
          ".read": true,
          ".write": "auth != null && root.child('users').child(auth.uid).child('shopCode').val() === $shopCode"
        },
        "busyGrid": {
          ".read": true,
          "$date": {
            "$stylistId": {
              ".write": "auth != null && root.child('users').child(auth.uid).child('shopCode').val() === $shopCode || newData.exists()"
            }
          }
        },
        "reservations": {
          "$date": {
            ".read": "auth != null && root.child('users').child(auth.uid).child('shopCode').val() === $shopCode",
            "$bookingId": {
              ".write": "auth != null && root.child('users').child(auth.uid).child('shopCode').val() === $shopCode || !data.exists()",
              ".validate": "newData.hasChildren(['time','endTime','duration','stylistId','name','phone','status','createdAt']) && newData.child('time').isString() && newData.child('endTime').isString() && newData.child('duration').isNumber() && newData.child('stylistId').isString() && newData.child('name').isString() && newData.child('phone').isString() && ((newData.child('status').val() === 'reserved') || (auth != null && root.child('users').child(auth.uid).child('shopCode').val() === $shopCode && newData.child('status').val() === 'cancelled')) && newData.child('createdAt').isNumber()"
            }
          }
        },
        "staffing": { ".read": true, ".write": "auth != null && root.child('users').child(auth.uid).child('shopCode').val() === $shopCode" },
        "staffBreaks": { ".read": true, ".write": "auth != null && root.child('users').child(auth.uid).child('shopCode').val() === $shopCode" },
        "blockedTimes": { ".read": true, ".write": "auth != null && root.child('users').child(auth.uid).child('shopCode').val() === $shopCode" },
        "slotCounts": { ".read": true, ".write": "auth != null && root.child('users').child(auth.uid).child('shopCode').val() === $shopCode" }
      }
    }
  }
}
